{
  "manifest_version": 3,
  "name": "WhatsApp Traducteur FR",
  "version": "1.0.0",
  "description": "Traduit automatiquement en français les messages WhatsApp Web écrits dans une autre langue.",
  "permissions": ["storage"],
  "host_permissions": ["https://translate.googleapis.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "WhatsApp Traducteur FR" }
}
